# =========================================================================
# AI Video Studio - 音色与云端 API 环境变量配置模板
# =========================================================================

# -------------------------------------------------------------------------
# 1. 默认 TTS 声音引擎 (可选: edge_tts / gpt_sovits / siliconflow / fish_audio / minimax)
#    - edge_tts: 默认商业级高保真神经语音 (云希，免开后台、极速出片)
#    - gpt_sovits: 专属个人真声克隆音色 (需先运行 scripts/start_local_sovits.bat 启动本地服务)
# -------------------------------------------------------------------------
TTS_PROVIDER=edge_tts

# -------------------------------------------------------------------------
# 2. 专属个人 GPT-SoVITS 本地服务配置
# -------------------------------------------------------------------------
GPT_SOVITS_API_URL=http://127.0.0.1:9880/tts
GPT_SOVITS_REF_AUDIO=models/reference_audio/my_voice_ref_5s.wav
GPT_SOVITS_PROMPT_TEXT=大家好，接下来我简单聊聊日常观察到的生活与技术里的小事。
GPT_SOVITS_CKPT=models/gpt_sovits/epanda_voice-e15.ckpt
GPT_SOVITS_PTH=models/gpt_sovits/epanda_voice_e8_s120.pth

# -------------------------------------------------------------------------
# 3. 商业云端 API (备用选填)
# -------------------------------------------------------------------------
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key
CUSTOM_VOICE_ID=FunAudioLLM/CosyVoice2-0.5B:alex
SILICONFLOW_MODEL=FunAudioLLM/CosyVoice2-0.5B

FISH_AUDIO_API_KEY=
FISH_VOICE_ID=

MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_VOICE_ID=
