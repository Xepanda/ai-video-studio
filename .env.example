# =========================================================================
# AI Video Studio - 音色克隆与云端 API 环境变量配置
# 复制本文件并重命名为 .env 即可生效
# =========================================================================

# -------------------------------------------------------------------------
# 1. TTS 服务商选择 (可选: siliconflow / fish_audio / minimax / edge_tts)
# 推荐首选 siliconflow (国内速度最快、支持 CosyVoice2 / FishSpeech 音色克隆)
# -------------------------------------------------------------------------
TTS_PROVIDER=siliconflow

# -------------------------------------------------------------------------
# 2. 硅基流动 (SiliconFlow) 配置
# 获取 API Key: https://cloud.siliconflow.cn/account/ak
# 运行 python scripts/register_voice.py 即可自动上传录音并填入 CUSTOM_VOICE_ID
# -------------------------------------------------------------------------
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key
SILICONFLOW_MODEL=FunAudioLLM/CosyVoice2-0.5B
CUSTOM_VOICE_ID=FunAudioLLM/CosyVoice2-0.5B:alex

# -------------------------------------------------------------------------
# 3. Fish Audio 配置 (备选)
# 获取 API Key: https://fish.audio/zh-CN/go-api/
# -------------------------------------------------------------------------
FISH_AUDIO_API_KEY=your-fish-audio-api-key
FISH_VOICE_ID=your-fish-voice-id

# -------------------------------------------------------------------------
# 4. MiniMax (海螺语音) 配置 (备选)
# -------------------------------------------------------------------------
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_GROUP_ID=your-minimax-group-id
MINIMAX_VOICE_ID=your-minimax-voice-id
