{
  "name": "ai-video-studio",
  "version": "1.0.0",
  "description": "全链路 AI 动画制作与视频自动化生产工作流 (Remotion + SenseVoice + Google Flow)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "remotion preview src/index.ts",
    "render": "remotion render src/index.ts MasterVideo out/master_video.mp4 --concurrency=6",
    "ingest": "python scripts/ingest_material.py",
    "dev:hf": "hyperframes preview",
    "check:hf": "hyperframes check",
    "render:hf": "hyperframes render",
    "validate": "python scripts/validator.py",
    "pipeline": "python scripts/pipeline.py",
    "pipeline:hf": "python scripts/pipeline.py --render --engine_render hyperframes",
    "bridge:to-chatcut": "node scripts/bridge/timeline_to_chatcut.js",
    "bridge:from-chatcut": "node scripts/bridge/chatcut_to_timeline.js",
    "bridge:watch": "node scripts/bridge/watch_chatcut.js",
    "qc": "python scripts/utils/visual_qc.py --video out/master_video.mp4",
    "cache:stats": "python scripts/utils/asset_cache_manager.py stats",
    "cache:clean": "python scripts/utils/asset_cache_manager.py clean",
    "hf:list": "python scripts/hf_builder.py --list-templates",
    "snapshot:create": "python scripts/utils/snapshot_manager.py create",
    "snapshot:list": "python scripts/utils/snapshot_manager.py list",
    "snapshot:rollback": "python scripts/utils/snapshot_manager.py rollback",
    "test:bridge": "node tests/test_bridge.js",
    "test:hf": "python tests/test_hf_builder.py",
    "test:audio": "python tests/test_audio_utils.py",
    "test:qc": "python tests/test_qc_cache.py",
    "test:all": "node tests/test_bridge.js && python tests/test_hf_builder.py && python tests/test_audio_utils.py && python tests/test_qc_cache.py"
  },
  "keywords": [
    "remotion",
    "video-automation",
    "ai-video",
    "sensevoice",
    "google-flow"
  ],
  "author": "",
  "license": "Apache-2.0",
  "type": "commonjs",
  "dependencies": {
    "@remotion/cli": "^4.0.517",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.517"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "hyperframes": "^0.8.147",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2"
  }
}
